---
import '../styles/global.css';

const {
  title = 'NOVAX Digital Solutions',
  description = 'NOVAX Digital Solutions accompagne les entreprises et particuliers avec des solutions numériques adaptées à leurs besoins en RDC et au-delà.',
  image = '/favicon.svg'
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f6fc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="NOVAX Digital Solutions" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>