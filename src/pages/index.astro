  <div id="novax-bot" class="fixed bottom-24 right-5 z-40 hidden w-[340px] rounded-[1.8rem] border border-slate-200 bg-white/95 p-4 shadow-[0_25px_60px_rgba(15,23,42,0.12)] backdrop-blur-sm sm:right-6">
