  <button
    id="bot-toggle"
    type="button"
    aria-label="Ouvrir l’assistant NOVAX"
    class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-slate-950 shadow-[0_15px_35px_rgba(15,23,42,0.25)] transition hover:-translate-y-1 hover:shadow-xl sm:right-6"
