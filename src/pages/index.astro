---
import Layout from '../layouts/Layout.astro';

const contact = {
  email: 'kaje.tracy@gmail.com',
  phone: '+33698533864',
  phoneDisplay: '+33 6 98 53 38 64',
  whatsappUrl: 'https://wa.me/33698533864?text=Bonjour%20NOVAX%2C%20je%20souhaite%20discuter%20de%20mon%20projet.',
  linkedinUrl: 'https://www.linkedin.com/in/tracy-kaje-2146a1255',
  githubUrl: 'https://github.com/TracyK-12',
  portfolioUrl: 'https://tracyk-12.github.io/MonPortfolio/',
  netFlowUrl: 'https://net-flow-app-sigma.vercel.app/',
  devisUrl: '/contact?subject=devis',
  contactUrl: '/contact?subject=projet',
};
---

<Layout title="NOVAX Digital Solutions">
  <header id="top" class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
      <a href="/" class="flex items-center gap-3 text-xl font-black tracking-tight text-slate-950">
        <img src="/novax-symbole.png" alt="Logo NOVAX" class="h-8 w-8 object-contain" />
        <span>
          NOVAX<span class="text-lime-400">.</span>
          <span class="ml-1 text-[9px] font-medium tracking-[0.25em] text-slate-500">
            DIGITAL SOLUTIONS
          </span>
        </span>
      </a>

      <nav class="hidden items-center gap-8 text-sm font-medium text-slate-700 md:flex" aria-label="Navigation principale">
        <a href="/" class="transition hover:text-indigo-500">Accueil</a>
        <a href="#solutions" class="transition hover:text-indigo-500">Solutions</a>
        <a href="#services" class="transition hover:text-indigo-500">Services</a>
        <a href="#realisations" class="transition hover:text-indigo-500">Réalisations</a>
        <a href="#ressources" class="transition hover:text-indigo-500">Ressources</a>
        <a href="#a-propos" class="transition hover:text-indigo-500">À propos</a>
      </nav>

      <a
        href={contact.contactUrl}
        class="hidden rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:shadow-lg md:block"
      >
        Parler de mon projet →
      </a>

      <button
        id="menu-button"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-slate-950 text-white md:hidden"
      >
        <span class="text-xl">☰</span>
      </button>
    </div>

    <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white md:hidden">
      <nav class="flex flex-col px-6 py-6" aria-label="Navigation mobile">
        <a href="/" class="border-b border-slate-100 py-4 text-sm font-semibold text-slate-800">Accueil</a>
        <a href="#solutions" class="border-b border-slate-100 py-4 text-sm font-semibold text-slate-800">Solutions</a>
        <a href="#services" class="border-b border-slate-100 py-4 text-sm font-semibold text-slate-800">Services</a>
        <a href="#realisations" class="border-b border-slate-100 py-4 text-sm font-semibold text-slate-800">Réalisations</a>
        <a href="#ressources" class="border-b border-slate-100 py-4 text-sm font-semibold text-slate-800">Ressources</a>
        <a href="#a-propos" class="border-b border-slate-100 py-4 text-sm font-semibold text-slate-800">À propos</a>
        <a href={contact.contactUrl} class="mt-5 rounded-full bg-slate-950 px-5 py-3.5 text-center text-sm font-bold text-white">
          Parler de mon projet →
        </a>
      </nav>
    </div>
  </header>

  <script>
    const button = document.querySelector('#menu-button');
    const menu = document.querySelector('#mobile-menu');

    const closeMenu = () => {
      menu?.classList.add('hidden');
      button?.setAttribute('aria-expanded', 'false');
      button?.setAttribute('aria-label', 'Ouvrir le menu');
    };

    button?.addEventListener('click', () => {
      const isOpen = !menu?.classList.contains('hidden');
      menu?.classList.toggle('hidden');
      button?.setAttribute('aria-expanded', String(!isOpen));
      button?.setAttribute('aria-label', isOpen ? 'Ouvrir le menu' : 'Fermer le menu');
    });

    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  </script>

  <main>
    <section class="overflow-hidden bg-[#f3f6fc]">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 lg:grid-cols-2 lg:px-8 lg:py-28">
        <div>
          <div class="mb-6 inline-flex rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-medium text-slate-600 shadow-sm">
            Agence de services numériques · RDC
          </div>

          <h1 class="max-w-3xl text-5xl font-black leading-[0.95] tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
            <span class="novax-title-line">
              <span>Votre projet,</span>
            </span>

            <span class="novax-title-line">
              <span class="relative inline-block">
                propulsé
                <span class="absolute inset-x-0 bottom-1 -z-0 h-4 bg-lime-200 sm:h-5"></span>
              </span>
            </span>

            <span class="novax-title-line">
              <span>par le numérique.</span>
            </span>
          </h1>

          <p class="mt-7 max-w-xl text-base leading-7 text-slate-600 sm:text-lg">
            NOVAX accompagne les entreprises et les particuliers dans leurs projets
            numériques grâce à l’IA, l’automatisation et des solutions digitales
            adaptées à leurs besoins.
          </p>

          <div class="mt-9 flex flex-wrap gap-4">
            <a
              href={contact.contactUrl}
              class="rounded-full bg-slate-950 px-6 py-3.5 text-sm font-bold text-white transition hover:-translate-y-1 hover:shadow-xl"
            >
              Parler de mon projet →
            </a>

            <a
              href="#solutions"
              class="rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-bold text-slate-900 transition hover:border-slate-950"
            >
              Découvrir nos solutions
            </a>
          </div>
        </div>

        <div class="relative mx-auto flex h-[380px] w-full max-w-lg items-center justify-center">
          <div class="absolute h-72 w-72 rounded-full bg-indigo-100 novax-float"></div>
          <div class="absolute h-56 w-56 rounded-full border border-indigo-300/60"></div>
          <div class="absolute h-40 w-40 rounded-full border border-indigo-300/50"></div>

          <div class="relative z-10 flex h-32 w-32 rotate-45 items-center justify-center rounded-3xl bg-slate-950 shadow-2xl">
            <div class="absolute h-20 w-5 rounded-full bg-lime-300"></div>
            <div class="absolute h-20 w-5 rotate-90 rounded-full bg-indigo-400"></div>
          </div>

          <span class="absolute left-16 top-20 h-3 w-3 rounded-full bg-lime-300 novax-pulse"></span>
          <span class="absolute right-20 top-24 h-3 w-3 rounded-full bg-indigo-500"></span>
          <span class="absolute bottom-20 left-24 h-2.5 w-2.5 rounded-full bg-slate-950"></span>

          <div class="absolute right-2 top-24 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold shadow-md">
            IA & automatisation
          </div>

          <div class="absolute bottom-20 right-10 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold shadow-md">
            Solutions digitales
          </div>

          <div class="absolute bottom-10 left-8 rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold shadow-md">
            Sur mesure
          </div>

          <div class="novax-orbit">
            <span class="novax-orbit-dot novax-dot-green"></span>
            <span class="novax-orbit-dot novax-dot-blue"></span>
            <span class="novax-orbit-dot novax-dot-dark"></span>
          </div>
        </div>
      </div>

      <div class="border-y border-slate-200 bg-lime-300">
        <div class="mx-auto flex max-w-7xl items-center justify-center gap-8 overflow-hidden px-6 py-3 text-[10px] font-bold uppercase tracking-[0.25em] text-slate-950">
          <span>IA & AUTOMATISATION</span>
          <span>•</span>
          <span>SOLUTIONS DIGITALES</span>
          <span>•</span>
          <span>DATA</span>
          <span>•</span>
          <span>CRÉATION</span>
          <span>•</span>
          <span>ACCOMPAGNEMENT</span>
        </div>
      </div>
    </section>

    <section id="solutions" class="novax-reveal bg-white px-6 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 max-w-2xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.25em] text-indigo-500">
            /01 — Nos solutions
          </p>

          <h2 class="text-4xl font-black leading-tight tracking-tight text-slate-950 sm:text-5xl">
            Deux univers,
            <span class="text-indigo-500">une même exigence.</span>
          </h2>

          <p class="mt-5 max-w-xl text-slate-600">
            Que vous soyez une entreprise ou un particulier, NOVAX vous accompagne
            avec des solutions numériques adaptées à vos besoins.
          </p>
        </div>

        <div class="grid gap-6 lg:grid-cols-2">
          <article class="group relative overflow-hidden rounded-3xl bg-lime-300 p-8 transition duration-300 hover:-translate-y-2 hover:shadow-2xl sm:p-10 novax-reveal">
            <div class="relative z-10">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-700">Pour les entreprises</p>

              <h3 class="mt-5 max-w-md text-3xl font-black leading-tight text-slate-950 sm:text-4xl">
                Digitalisez, automatisez, structurez.
              </h3>

              <p class="mt-5 max-w-lg leading-7 text-slate-800">
                Des solutions digitales pour gagner en efficacité, simplifier
                vos processus et développer votre activité.
              </p>

              <div class="mt-7 flex flex-wrap gap-2">
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">IA & automatisation</span>
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">Sites web</span>
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">Data</span>
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">Gestion de projet</span>
              </div>

              <a href="#services" class="mt-8 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white transition hover:scale-105">
                Explorer les solutions →
              </a>
            </div>

            <div class="absolute -bottom-20 -right-16 h-56 w-56 rotate-45 rounded-[3rem] border-[24px] border-lime-200/60"></div>
          </article>

          <article class="group relative overflow-hidden rounded-3xl bg-indigo-400 p-8 transition duration-300 hover:-translate-y-2 hover:shadow-2xl sm:p-10 novax-reveal">
            <div class="relative z-10">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-white/80">Pour les particuliers</p>

              <h3 class="mt-5 max-w-md text-3xl font-black leading-tight text-slate-950 sm:text-4xl">
                Lancez votre présence en ligne.
              </h3>

              <p class="mt-5 max-w-lg leading-7 text-slate-950/80">
                CV, candidature, formation ou projet : un accompagnement simple
                pour vous aider à avancer professionnellement.
              </p>

              <div class="mt-7 flex flex-wrap gap-2">
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">CV & candidature</span>
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">Recherche d'emploi</span>
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">Formation</span>
                <span class="rounded-full bg-white/70 px-3 py-1.5 text-xs font-semibold">Accompagnement</span>
              </div>

              <a href="#services" class="mt-8 inline-flex rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white transition hover:scale-105">
                Explorer les solutions →
              </a>
            </div>

            <div class="absolute -bottom-24 -right-20 h-64 w-64 rounded-full border-[28px] border-indigo-300/60"></div>
          </article>
        </div>
      </div>
    </section>

    <section id="services" class="novax-reveal bg-[#f3f6fc] px-6 py-24 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="mb-14 max-w-2xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.25em] text-indigo-500">
            /02 — Services
          </p>

          <h2 class="text-4xl font-black leading-tight tracking-tight text-slate-950 sm:text-5xl">
            Tout ce qu'il faut
            <span class="text-indigo-500"> pour avancer.</span>
          </h2>

          <p class="mt-5 max-w-xl text-slate-600">
            Des services numériques pensés pour répondre aux besoins concrets
            des entreprises et des particuliers.
          </p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          <article class="group rounded-3xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-2 hover:shadow-xl novax-reveal">
            <div class="mb-8 flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-lime-300 font-bold text-slate-950">✦</div>
              <span class="text-xs font-bold text-slate-400">01</span>
            </div>
            <h3 class="text-xl font-black text-slate-950">IA & Automatisation</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Automatisations intelligentes avec Make, Airtable, OpenAI, Claude et WhatsApp Business pour répondre plus vite, qualifier les demandes et structurer les informations clients.
            </p>
            <a href={contact.contactUrl} class="mt-6 inline-block text-sm font-bold text-slate-950">En savoir plus →</a>
          </article>

          <article class="group rounded-3xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-2 hover:shadow-xl novax-reveal">
            <div class="mb-8 flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-400 font-bold text-white">◇</div>
              <span class="text-xs font-bold text-slate-400">02</span>
            </div>
            <h3 class="text-xl font-black text-slate-950">Sites & Pages vitrines</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Une présence digitale moderne, claire et adaptée à votre activité.
            </p>
            <a href={contact.contactUrl} class="mt-6 inline-block text-sm font-bold text-slate-950">En savoir plus →</a>
          </article>

          <article class="group rounded-3xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-2 hover:shadow-xl novax-reveal">
            <div class="mb-8 flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-lime-300 font-bold text-slate-950">◫</div>
              <span class="text-xs font-bold text-slate-400">03</span>
            </div>
            <h3 class="text-xl font-black text-slate-950">Data & Organisation</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Organisez vos données, tableaux de suivi et informations pour mieux piloter votre activité.
            </p>
            <a href={contact.contactUrl} class="mt-6 inline-block text-sm font-bold text-slate-950">En savoir plus →</a>
          </article>

          <article class="group rounded-3xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-2 hover:shadow-xl novax-reveal">
            <div class="mb-8 flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-400 font-bold text-white">✎</div>
              <span class="text-xs font-bold text-slate-400">04</span>
            </div>
            <h3 class="text-xl font-black text-slate-950">Création & Branding</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Logos, supports visuels et éléments de communication pour donner une identité forte à votre projet.
            </p>
            <a href={contact.contactUrl} class="mt-6 inline-block text-sm font-bold text-slate-950">En savoir plus →</a>
          </article>

          <article class="group rounded-3xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-2 hover:shadow-xl novax-reveal">
            <div class="mb-8 flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-lime-300 font-bold text-slate-950">◉</div>
              <span class="text-xs font-bold text-slate-400">05</span>
            </div>
            <h3 class="text-xl font-black text-slate-950">Gestion de projet</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Structurez vos projets, suivez les tâches et avancez avec une organisation claire et efficace.
            </p>
            <a href={contact.contactUrl} class="mt-6 inline-block text-sm font-bold text-slate-950">En savoir plus →</a>
          </article>

          <article class="group rounded-3xl border border-slate-200 bg-white p-7 transition duration-300 hover:-translate-y-2 hover:shadow-xl novax-reveal">
            <div class="mb-8 flex items-center justify-between">
              <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-400 font-bold text-white">↗</div>
              <span class="text-xs font-bold text-slate-400">06</span>
            </div>
            <h3 class="text-xl font-black text-slate-950">Accompagnement digital</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Un accompagnement adapté pour vous aider à transformer une idée en solution concrète.
            </p>
            <a href={contact.contactUrl} class="mt-6 inline-block text-sm font-bold text-slate-950">En savoir plus →</a>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="novax-reveal bg-slate-950 px-6 py-24 text-white lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid gap-16 lg:grid-cols-2 lg:items-end">
          <div>
            <p class="mb-5 text-xs font-bold uppercase tracking-[0.25em] text-lime-300">/03 — Pourquoi NOVAX</p>
            <h2 class="max-w-2xl text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">
              Un partenaire qui
              <span class="text-lime-300">comprend votre terrain.</span>
            </h2>
            <p class="mt-6 max-w-xl leading-7 text-slate-300">
              NOVAX propose des solutions numériques pensées pour les réalités des entreprises et des particuliers en RDC.
            </p>
          </div>

          <div class="space-y-0">
            <div class="border-t border-white/15 py-6">
              <div class="flex gap-6">
                <span class="text-sm font-bold text-lime-300">01</span>
                <div>
                  <h3 class="text-xl font-bold">Pensé pour la RDC</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-400">
                    Des solutions adaptées aux besoins et aux réalités du marché local.
                  </p>
                </div>
              </div>
            </div>

            <div class="border-t border-white/15 py-6">
              <div class="flex gap-6">
                <span class="text-sm font-bold text-lime-300">02</span>
                <div>
                  <h3 class="text-xl font-bold">Une approche accessible</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-400">
                    Des outils numériques compréhensibles et adaptés à différents budgets.
                  </p>
                </div>
              </div>
            </div>

            <div class="border-t border-white/15 py-6">
              <div class="flex gap-6">
                <span class="text-sm font-bold text-lime-300">03</span>
                <div>
                  <h3 class="text-xl font-bold">Du sur-mesure</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-400">
                    Chaque projet part de vos besoins et de vos objectifs.
                  </p>
                </div>
              </div>
            </div>

            <div class="border-y border-white/15 py-6">
              <div class="flex gap-6">
                <span class="text-sm font-bold text-lime-300">04</span>
                <div>
                  <h3 class="text-xl font-bold">Un accompagnement durable</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-400">
