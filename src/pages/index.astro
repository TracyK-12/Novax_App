  <a
    href={contact.whatsappUrl}
    target="_blank"
    rel="noreferrer"
    aria-label="Contacter NOVAX sur WhatsApp"
    class="fixed bottom-24 right-24 z-40 flex items-center gap-3 rounded-full bg-[#25D366] p-3 text-sm font-bold text-white shadow-lg shadow-emerald-500/30 transition hover:-translate-y-1 hover:shadow-xl sm:right-24"
  >
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15 text-base">✆</span>
  </a>

  <script>
    const botToggle = document.querySelector('#bot-toggle');
    const botPanel = document.querySelector('#novax-bot');
    const botClose = document.querySelector('#bot-close');
    const botForm = document.querySelector('#bot-form');
    const botInput = document.querySelector('#bot-input');
    const botMessages = document.querySelector('#bot-messages');
    const botTyping = document.querySelector('#bot-typing');

    const scrollBotToBottom = () => {
      if (botMessages) {
        botMessages.scrollTop = botMessages.scrollHeight;
      }
    };

    const addBotMessage = (message, isUser = false) => {
      if (!botMessages) return;

      const wrapper = document.createElement('div');
      wrapper.className = isUser
        ? 'ml-auto max-w-[80%] rounded-2xl bg-slate-950 px-3 py-2 text-sm leading-6 text-white shadow-sm transition-all duration-300'
        : 'max-w-[85%] rounded-2xl bg-slate-100 p-3 text-sm leading-6 text-slate-700 shadow-sm transition-all duration-300';
      wrapper.textContent = message;
      botMessages.appendChild(wrapper);
      scrollBotToBottom();
    };

    const showTyping = () => {
      if (botTyping) {
        botTyping.classList.remove('hidden');
        botTyping.classList.add('flex');
      }
    };

    const hideTyping = () => {
      if (botTyping) {
        botTyping.classList.add('hidden');
        botTyping.classList.remove('flex');
      }
    };

    const getBotReply = (message) => {
      const text = message.toLowerCase();

      if (text.includes('site') || text.includes('vitrine')) {
        return 'Un site vitrine permet de présenter votre offre, capter des demandes et rassurer vos prospects. On peut partir sur une structure claire, moderne et efficace.';
      }

      if (text.includes('automatis') || text.includes('ia') || text.includes('chatgpt') || text.includes('claude')) {
        return 'L’automatisation et l’IA sont parfaites pour réduire le temps de réponse, qualifier les demandes et structurer les informations sans friction.';
      }

      if (text.includes('prix') || text.includes('devis') || text.includes('budget')) {
        return 'Le devis dépend du périmètre, du niveau de personnalisation et des outils à mettre en place. On peut en parler concrètement avec votre besoin.';
      }

      if (text.includes('whatsapp') || text.includes('contact') || text.includes('message')) {
        return 'Vous pouvez nous écrire directement sur WhatsApp ou via le formulaire de contact pour échanger sur votre projet.';
      }

      if (text.includes('bonjour') || text.includes('salut')) {
        return 'Bonjour ! Dites-moi ce que vous souhaitez faire : site, automatisation, IA, data ou accompagnement digital.';
      }

      return 'Merci pour votre message. On peut étudier votre besoin, définir la bonne solution et vous proposer une piste adaptée au projet.';
    };

    const handleBotSubmit = (value) => {
      if (!value) return;
      addBotMessage(value, true);
      showTyping();

      window.setTimeout(() => {
        hideTyping();
        addBotMessage(getBotReply(value));
      }, 500);
    };

    botToggle?.addEventListener('click', () => {
      botPanel?.classList.toggle('hidden');
      if (!botPanel?.classList.contains('hidden')) {
        botInput?.focus();
      }
    });

    botClose?.addEventListener('click', () => {
      botPanel?.classList.add('hidden');
    });

    document.querySelectorAll('[data-bot-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.getAttribute('data-bot-choice');
        if (!value) return;
        handleBotSubmit(value);
      });
    });

    botForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const value = botInput?.value.trim();
      if (botInput) botInput.value = '';
      handleBotSubmit(value);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        botPanel?.classList.add('hidden');
      }
    });

    const revealElements = document.querySelectorAll('.novax-reveal');

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
      }
    );

    revealElements.forEach((element) => {
      revealObserver.observe(element);
    });
  </script>
